{
  "name": "typhoon",
  "version": "0.0.0",
  "scripts": {
    "commit": "cz",
    "ng": "ng",
    "format": "prettier --write \"src/**/*.(ts|html|less)\"",
    "start": "ng serve",
    "start:dev": "ng serve --open",
    "start:test": "ng serve --open --proxy-config=proxy.test.conf.json",
    "start:stage": "ng serve --open --proxy-config=proxy.stage.conf.json --configuration development",
    "start:m": "ng serve --open --proxy-config=proxy.stage.conf.json  --configuration stage --host 0.0.0.0",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "publish:build": "gulp build",
    "publish:dev": "gulp dev",
    "publish:stage": "gulp stage",
    "publish:prod": "gulp prod",
    "test": "ng test",
    "max": "export NODE_OPTIONS=--max_old_space_size=6000"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.1.5",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.1.5",
    "@angular/compiler": "^19.1.5",
    "@angular/core": "^19.1.5",
    "@angular/forms": "^19.1.5",
    "@angular/platform-browser": "^19.1.5",
    "@angular/platform-browser-dynamic": "^19.1.5",
    "@angular/router": "^19.1.5",
    "@turf/turf": "^6.5.0",
    "animate.css": "^4.1.1",
    "color": "^4.2.3",
    "crypto-es": "^2.1.0",
    "d3": "^7.9.0",
    "dayjs": "^1.11.13",
    "docx-preview": "^0.3.0",
    "echarts": "^5.6.0",
    "echarts-gl": "^2.0.9",
    "exceljs": "^4.4.0",
    "gsap": "^3.12.5",
    "leaflet": "^1.9.4",
    "lodash-es": "^4.17.21",
    "marked": "^15.0.12",
    "ng-zorro-antd": "^19.0.2",
    "ng2-pdf-viewer": "~10.0.0",
    "ngx-markdown": "^19.1.1",
    "proj4leaflet": "^1.0.2",
    "rxjs": "~7.8.1",
    "shpjs": "^3.0.4",
    "sm-crypto": "^0.3.13",
    "socket.io-client": "^4.8.1",
    "ts-md5": "^1.3.1",
    "tslib": "^2.6.2",
    "uuid": "^9.0.1",
    "video.js": "^8.12.0",
    "zod": "^3.24.2",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.1.6",
    "@angular/cli": "^19.1.6",
    "@angular/compiler-cli": "^19.1.5",
    "@types/color": "^3.0.6",
    "@types/d3": "^7.4.3",
    "@types/jasmine": "~5.1.4",
    "@types/leaflet": "^1.9.8",
    "@types/lodash-es": "^4.17.12",
    "@types/proj4leaflet": "^1.0.10",
    "@types/shpjs": "^3.4.6",
    "@types/uuid": "^9.0.8",
    "buffer": "^6.0.3",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "file-loader": "^6.2.0",
    "gulp": "^4.0.2",
    "gulp-shell": "^0.8.0",
    "gulp-zip": "^6.0.0",
    "jasmine-core": "~5.1.1",
    "karma": "~6.4.2",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.5.4"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
