# typhoon 智能体 nginx 配置模板（无密钥，部署机按实际路径填写）
# 使用：复制为部署机 nginx 的 conf/nginx.conf，替换 {{...}} 占位符。
worker_processes  1;

events {
    worker_connections  1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile        on;
    keepalive_timeout  65;
    client_max_body_size 100m;   # 上传文件大小上限

    server {
        listen       {{HTTP_PORT}};          # 如 12080
        server_name  {{SERVER_NAME}};        # 如 localhost 或学校域名

        # 前端静态（构建产物部署目录）
        location / {
            root   {{CLIENT_DIR}};           # 如 C:/data/sch-typhoon/client
            index  index.html;
            try_files $uri $uri/ /index.html;
        }

        # API 反代（rewrite 去掉 /api 前缀；SSE 必须关闭缓冲保证流式即时）
        location /api/ {
            proxy_pass         http://{{BACKEND_HOST}}/;   # 如 127.0.0.1:3000
            proxy_http_version 1.1;
            proxy_set_header   Host $host;
            proxy_set_header   X-Real-IP $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
            proxy_buffering    off;
            proxy_cache        off;
            proxy_read_timeout 120s;
        }

        # WebSocket（socket.io 实时推送）
        location /socket.io/ {
            proxy_pass         http://{{BACKEND_HOST}};
            proxy_http_version 1.1;
            proxy_set_header   Upgrade $http_upgrade;
            proxy_set_header   Connection "upgrade";
            proxy_set_header   Host $host;
            proxy_read_timeout 3600s;
        }

        # 地图瓦片（如存在）
        location /tiles/ {
            alias {{TILES_DIR}};             # 如 C:/data/sch-typhoon/tiles/
        }
    }
}
