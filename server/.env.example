SERVER_HOST=0.0.0.0
PORT=3000
SECRET=replace-with-a-random-jwt-secret
DATABASE_URI=mongodb://127.0.0.1:27017/schooltyphoon?replicaSet=rs0

# 历史/实时台风数据（APISpace）
TYPHOON_API_HOST=https://eolink.o.apispace.com
TYPHOON_API_TOKEN=replace-with-a-new-token

# 和风天气 JWT 配置。私钥文件只放部署机器，不提交到 Git。
QWEATHER_API_HOST=https://your-project-host.re.qweatherapi.com
QWEATHER_KEY_ID=replace-with-key-id
QWEATHER_PROJECT_ID=replace-with-project-id
QWEATHER_PRIVATE_KEY_PATH=qweather/ed25519-private.pem

EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_API_KEY=replace-with-embedding-key
EMBEDDING_BASE_URL=https://example.com/v1
EMBEDDING_DIMENSION=1024
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION_NAME=knowledge_base

# 智能体依赖的模型配置；按部署环境填写真实值。
LLM_MODEL=replace-with-model-name
LLM_API_KEY=replace-with-llm-key
LLM_BASE_URL=https://example.com/v1
KB_UPLOAD_DIR=./upload/knowledge-base
KB_CHUNK_SIZE=1000
KB_CHUNK_OVERLAP=200
